{
  "name": "member-profile-demo-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Repository documentation and formatting checks; not an application scaffold.",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "lint": "npm run lint:markdown && npm run format:check && npm run lint:links",
    "lint:markdown": "markdownlint-cli2",
    "lint:links": "node .github/scripts/check-markdown-links.mjs",
    "test:tooling": "node --test tests/unit/tooling/*.test.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "markdown-link-check": "3.11.2",
    "markdownlint-cli2": "0.16.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "link-check": "5.2.0",
    "js-yaml": "4.3.2",
    "markdown-it": "14.3.3"
  }
}
